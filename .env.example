# 复制成 .env 后填写真实值：cp .env.example .env
# 注意：.env 已被 .gitignore / .dockerignore 排除，不会进仓库、也不会进镜像。

# ── 金蝶云星空连接（必填 4 项）────────────────────────────────
# 地址结尾必须带 /k3cloud/，少了这一段登录会 404
KINGDEE_SERVER_URL=http://your-server/k3cloud/
KINGDEE_ACCT_ID=your_account_id
KINGDEE_USERNAME=your_username
KINGDEE_PASSWORD=your_password
# 语言，2052=简体中文（可不填，默认 2052）
KINGDEE_LCID=2052

# 本服务只支持账号密码登录（ValidateUser）。
# 0.1.x 时代的第三方应用授权 APP_ID / APP_SEC 已不再使用，填了也不生效。

# ── 传输方式（容器里一般不用改，compose 已设好）─────────────────
# KINGDEE_MCP_TRANSPORT=streamable-http   # stdio / sse / streamable-http
# KINGDEE_MCP_HOST=0.0.0.0
# KINGDEE_MCP_PORT=8000

# ── SQL Server 直连探查（可选，不用就整段留空）──────────────────
# MCP_SQLSERVER_HOST=
# MCP_SQLSERVER_PORT=1433
# MCP_SQLSERVER_DATABASE=
# MCP_SQLSERVER_USER=
# MCP_SQLSERVER_PASSWORD=
# MCP_SQLSERVER_SCHEMA=dbo
# MCP_SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
